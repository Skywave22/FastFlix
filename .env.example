# This file is bundled into the app. Add only public client configuration.
# Copy to .env and provide the values already used by your existing setup.
# Existing public client keys; leave the established handling in place during F0.
TMDB_API_KEY=
MIXPANEL_API_KEY=
OPENSUBTITLES_API_KEY=
CONSUMET_URL=
# Upstream's documented URL is an example, not a verified live service. Supply
# an authorized Scraper API v2 base URL, or leave blank for direct fallback.
FLIXQUEST_API_URL=
FLIXHQ_NEW_URL=
FLIXAPI_URL=

# Use a URL reachable by the target device, including its port when needed.
# /api/v1 is appended automatically if omitted. Build defines take precedence.
# Initial backend URL; Firebase Remote Config's laravel_api_url can replace it
# asynchronously after startup (users, billing, wallet, sync and other APIs).
LARAVEL_API_URL=http://10.0.2.2:8000

# Public OneSignal App ID (never the REST API key). Empty keeps the plain FCM
# client. A --dart-define=ONESIGNAL_APP_ID build define takes precedence.
ONESIGNAL_APP_ID=
